# Copy to .env.local (never commit .env.local) and fill in. Same names go into Vercel → Settings → Environment Variables.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=wlsn-photos
# The public bucket's r2.dev URL, no trailing slash, e.g. https://pub-xxxxxxxx.r2.dev
NEXT_PUBLIC_PHOTO_BASE_URL=

# What this deployment serves: "public" (portfolio only, the default), "admin" (admin only) or "all" (local dev).
SITE_MODE=all
# Shared by both deployments so the admin can tell the public site to refresh. Generate like the session secret.
REVALIDATE_SECRET=
# Admin deployment only: the public site's address, e.g. https://wlsn-portfolio.vercel.app
PUBLIC_SITE_URL=

# Admin deployment only. Password: at least 16 characters.
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional public-site Search Console verification token (the content value only).
GOOGLE_SITE_VERIFICATION=
